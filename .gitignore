# ─── Build / packaging artifacts ──────────────────────────────────────────────
build/
dist/
*.spec
*.manifest
# ...except the PyInstaller specs themselves: they are the build recipes (hidden
# imports, the data folders copied next to the executable), not artifacts.
# Losing them means the bundle has to be reverse-engineered to be rebuilt.
# Specs generated by an ad-hoc `pyinstaller script.py` run stay ignored.
!ONTbarcoder3.spec
!ONTbarcoder3_linux.spec

# ─── PyInstaller / Python bytecode ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyd

# ─── Runtime / user data ─────────────────────────────────────────────────────
output/
_profiles/*.json
!_profiles/blast_config.example.json

# ─── Local reference copy of the upstream original (kept for diffing only) ────
original/

# ─── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/

# ─── Editor / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
tools/
