# ─── Build / packaging artifacts ──────────────────────────────────────────────
build/
dist/
*.spec
*.manifest
# ...except the PyInstaller spec itself: it is the build recipe (hidden imports,
# the data folders copied next to the executable), not an artifact. Losing it
# means the bundle has to be reverse-engineered to be rebuilt.
!ONTbarcoder3.spec

# ─── PyInstaller / Python bytecode ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyd

# ─── Runtime / user data ─────────────────────────────────────────────────────
output/
_profiles/*.json
!_profiles/blast_config.example.json

# ─── Local reference copy of the upstream original (kept for diffing only) ────
original/

# ─── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/

# ─── Editor / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
tools/
